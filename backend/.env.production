# Production Environment Variables
# Copy this to .env and fill in your values

NODE_ENV=production
PORT=3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-min-64-characters-recommended

# Database (PostgreSQL)
USE_DATABASE=true
DB_HOST=your-database-host
DB_PORT=5432
DB_NAME=eventapp
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Firebase (if using)
USE_FIREBASE=false

# CORS
CORS_ORIGIN=https://your-mobile-app-domain.com,https://your-web-app-domain.com

# Request Size Limits
MAX_REQUEST_SIZE=10mb
